# API key for your chosen provider (Anthropic, Groq, or OpenAI)
STUDYMATE_API_KEY=your-api-key-here

# Which LLM provider to use — "anthropic" (default), "groq", or "openai"
STUDYMATE_PROVIDER=anthropic

# Model name to pass to the provider API
# Anthropic default: claude-opus-4-7
# Groq default:      llama-3.3-70b-versatile
# OpenAI example:    gpt-4o
# Leave empty for the provider default, or set a model available to your account.
STUDYMATE_MODEL=

# Base URL override — only required for Groq or other OpenAI-compatible providers
# Leave unset when using the official Anthropic SDK
# Groq: https://api.groq.com/openai/v1
# OpenAI: https://api.openai.com/v1
STUDYMATE_BASE_URL=

# Path to the JSON file where conversation history is persisted between sessions
# Relative paths are resolved from the working directory
STUDYMATE_MEMORY_FILE=memory.json
